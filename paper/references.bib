@misc{wwa2025korea,
  title = {Climate change made weather conditions leading to deadly South Korean wildfires about twice as likely},
  author = {{World Weather Attribution}},
  year = {2025},
  howpublished = {World Weather Attribution rapid study, 30 April 2025},
  url = {https://www.worldweatherattribution.org/climate-change-made-weather-conditions-leading-to-deadly-south-korean-wildfires-about-twice-as-likely/},
  note = {re-verified 2026-09-04 (paper lap 2) at this URL, correcting the paraphrase this note carried after lap 1. The page states verbatim: "With 32 casualties, the fires are also South Korea's deadliest wildfires on record"; "Uiseong was hardest hit, with 26 deaths, while four occurred in Sancheong"; "More than 48,000 hectares burned"; "Around 5,000 buildings, including homes, factories, and farms, were destroyed"; "displacing about 37,000 residents". The lap-1 note rendered the second of these as "26 of them in Uiseong-gun", which converted a fire attribution into a county one and dropped the four Sancheong deaths — the fact that reconciles 26 with 32. The 48,000 ha is on a "southeastern Korea" extent and disagrees with the 99,289 ha the province gives for the Uiseong chain; see docs/data_sources.md}
}

