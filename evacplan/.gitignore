# Never commit raw rasters, weights, downloaded data or generated run outputs
__pycache__/
*.egg-info/
.pytest_cache/
.hypothesis/
*.tif
*.tiff
*.nc
*.npz
*.pt
*.pth
*.ckpt
*.safetensors
*.zip
*.graphml
*.osm
*.pbf
# downloads for real regions (OSM, CMS, geocodes, perimeters)
/data/
/runs/
# regenerated instances (evacplan/cache/instances/<id>/); see instances/SPLIT.json
/cache/
# plans and oracle results (large; regenerable from a row's commit and config). The result rows,
# results/<method>.csv and results/<method>.facilities.csv, are committed with LEADERBOARD.md.
/results/runs/
/build/
