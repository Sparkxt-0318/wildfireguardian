{
 "schema": "firecast-lab/splits/v1",
 "frozen_utc": "2026-10-31",
 "status": "Frozen before any Track A modelling code. Built from repo metadata only (events.json and the c651 checkpoint contract); no model output or test outcome was read. Changing membership, folds or the window rule needs Siyeong's approval.",
 "unit": "whole fire: every cell, hour, cutoff and survey pair of a fire inherits the fire's split and fold; nothing is split by cell or window",
 "catalog": {
  "path": "forecast/data/environment/events.json",
  "sha256": "607f831ea64235449d7eb19e5cd931099486aaae44de1221c1ec27b34965ac8b",
  "event_count": 44
 },
 "rules": [
  "dev: every model, hyperparameter, calibration and threshold choice. Dev scores are cross-fitted: fit on the other folds, predict the left-out fold of whole fires.",
  "test: touched only at milestones, after Siyeong approves; one pre-declared scoring per frozen candidate; no design iteration on test results.",
  "fresh_holdout: locked. Nothing loads, scores or inspects it until a final claim, after Siyeong approves.",
  "Korean (reconstruction-only truth) and US (NIROPS truth) scores are reported separately and never pooled.",
  "Uncertainty: whole-fire bootstrap; repeated windows of one fire are not independent fires."
 ],
 "window_rule": {
  "headline_lead_h": 24,
  "secondary_lead_h": 12,
  "reconstruction_cutoffs": "c = start_utc + 12 h * k for k >= 1 with c + lead < end_utc. approx_windows_* apply this rule to events.json times only; the exact rule also needs at least one reconstructed burned cell at c, which needs the arrival rasters (not on this host).",
  "nirops_windows": "24 h lead: consecutive NIROPS survey pairs lasting 20 to 28 h, forecast to the exact survey endpoint. Continuity diagnostic: all pairs in (0, 48] h, as preregistered by forecast-v2.",
  "why": "firecast-lab/docs/DATA_NOTES.md (label timing uncertainty)"
 },
 "flag_definitions": {
  "too_short_24h": "approx_windows_24h == 0: under window_rule the fire cannot supply a headline 24 h window.",
  "no_c651_rows": "c651's prepared cache holds no row of this fire (too small or short for a complete 9x9 context with a burned neighbour), so c651 neither trained nor was scored on it."
 },
 "c651_role_definitions": {
  "train+validation": "in-sample for c651 (its cell-hour train/validation rows came from this fire)",
  "test": "held out from c651 fitting and selection; c651 test rows exist",
  "test_declared_no_rows": "declared c651 test fire, but the prepared cache has no rows",
  "none": "no c651 rows anywhere",
  "source": "c651 checkpoint contract.splits (decoded without torch) and forecast/runs/20261010_categorical_balanced_benchmark/protocol.json original_splits; row counts in forecast/documents/weighted_stratified_split_20261009.md:27-35 and observed_combined_evaluation.md:293-294"
 },
 "folds": {
  "Y2020": "US 2020 fires",
  "Y2021": "US 2021 fires",
  "Y2022_2023": "US 2022 + KR 2022 + KR 2023 fires; 2022 and 2023 are merged because the KR 2023 fires are too small to stand alone, and there is no US 2023 fire in the catalog"
 },
 "splits": {
  "dev": {
   "why": "Every fire outside the held-out seasons: the development seasons of both earlier programs (c651 and forecast-v2).",
   "cross_fitting": "Leave one fold out. Fit calibrators on pooled out-of-fold dev predictions, never on test.",
   "caveats": [
    "c651 is in-sample on 25 dev fires (c651_role train+validation): label c651 dev scores in-sample.",
    "All KR dev fires sit in fold Y2022_2023, so their out-of-fold predictions come from models fitted on US 2020-2021 fires only.",
    "Only KFS_02 and KFS_03 give KR dev signal for a 9x9-context model; per-country KR calibration cannot be fitted from dev."
   ]
  },
  "test": {
   "why": "This repo's held-out seasons, US 2024 and KR 2025. c651 was fitted and selected on the other seasons only.",
   "not_fresh": "These fires were already scored and inspected by earlier studies (the c651 observed NIROPS study and the forecast-v2 held-out study, whose primary criterion failed). Treat test as a used replication set, not fresh evidence.",
   "kr_truth": "reconstruction only (no independent Korean timing truth); KFS_06 and KFS_13 have no c651 rows",
   "us_truth": "NIROPS v1 survey perimeters: 324 consecutive survey pairs, 195 lasting 20 to 28 h, 273 lasting at most 48 h (catalog/*/provenance.json)"
  },
  "fresh_holdout": {
   "locked": true,
   "fires": [],
   "why_empty": "NIROPS v1 (Mendeley 10.17632/95rj5d379g.1) covers June 2020 to Nov/Dec 2024 only, and no release with 2025 surveys is confirmed (Mendeley is blocked from this host). No 2026 Korean reconstruction exists (Choi et al. deposit v3.0.0 ends with 2025 events).",
   "us_2025_membership_rule": "Every 2025 incident in USFS Regions 1-6 in the first NIROPS release covering 2025 that meets the publisher's inclusion rule and has at least one consecutive survey pair lasting 20 to 28 h. Membership is fixed by this rule, never by looking at outcomes.",
   "kr_2026_membership_rule": "Every 2026 Korea Forest Service event in the first arrival reconstruction covering 2026 with at least one 24 h window under window_rule.",
   "not_included": {
    "us_2026": "Reserved by forecast/documents/preregistration_blind_test.md for the owner's blind test (no access before the owner's OSF registration). Not part of this holdout.",
    "us_2023_nirops": "US 2023 incidents are in NIROPS v1 but not in the 44-event catalog, and no earlier model used them. They could become a usable holdout now but need new environment stacks. Open question for Siyeong."
   }
  }
 },
