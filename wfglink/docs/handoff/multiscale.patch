+# Far embers in a 2560x1440 frame (configs/suites/hires.yaml): the core base case with its
+# scale and speeds doubled for the larger frame; small (PSF sigma 0.6 to 1.2 px) and faint.
+frame_size: [2560, 1440]
+px_per_m: 80.0                   # twice the core scale, so terminal velocities are twice as many px/s
