# WildfireGuardian 사전 대피계획 도구 — configuration (copy to planner/.env; .env is gitignored).
# No secrets are required. Never commit a real VWORLD_API_KEY.

# The one switch: which Route-Check API the app talks to.
#   mock  → the MOCK server (python3 planner/mock_api/server.py) on http://127.0.0.1:8765.
#           Recorded results only; the UI shows a MOCK badge.
#   real  → the real Route-Check API at VITE_WFG_API_TARGET (default http://127.0.0.1:8765; to start
#           it see planner/README.md "Real Route-Check API"). No MOCK labels unless results say so.
# The browser always calls same-origin /api/v1/*; `npm run dev` and `npm run preview` proxy it.
VITE_WFG_API_MODE=mock

# Real API base (without /v1). Used only when VITE_WFG_API_MODE=real.
VITE_WFG_API_TARGET=http://127.0.0.1:8765

# Departure offset step in minutes (5, 10, 15, 20 or 30) over the scenario window [0, horizon).
VITE_DEPARTURE_STEP_MIN=10

# Candidate shelters per origin: the K nearest by straight-line distance with K distinct entry nodes (1–5).
VITE_SHELTERS_PER_ORIGIN=3

# 1 (default): a scenario without a precomputed cache offers "점검 시작" (a batch through the API).
# 0: against a real API it never does (booth: nobody starts hours of checks by browsing). The mock is unaffected.
VITE_WFG_ALLOW_BATCH=1

# Optional: VWorld (국토교통부) raster background, shown only when the user switches it on.
# It is an internet service; leave empty for the fully offline booth setup.
VWORLD_API_KEY=

# Server-side only (not exposed to the browser): folder served at /cache/** in dev/preview and
# copied into dist/cache on build. Default planner/cache (the booth cache). Results computed on a
# non-evaluation host go to planner/.test-cache (ARCHITECTURE.md §6); the app marks them
# "시험 데이터 · 평가 호스트 아님". View them for one run only, on the command line:
#   WFG_CACHE_DIR=.test-cache npm run dev
# Do not set it here permanently (a later build would ship test data).
# WFG_CACHE_DIR=.test-cache
