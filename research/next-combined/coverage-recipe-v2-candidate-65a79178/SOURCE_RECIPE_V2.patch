+    end = source.index('    times = ', begin)
+    source = source[:begin] + '    data = np.load(perimeters / event / "states.npz")\n' + source[end:]
+    source = source.replace('    if hasattr(env, "_verify_sources"):\n        env._verify_sources(event)\n', '', 1)
