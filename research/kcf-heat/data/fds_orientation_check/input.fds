&HEAD CHID='orient_test', TITLE='Gas-phase radiometer orientation check: hot panel at x=0 facing +x' /
&MESH IJK=40,20,20, XB=0,10,-2.5,2.5,0,5 /
&TIME T_END=10.0 /
&MISC TMPA=20. /
&RADI NUMBER_RADIATION_ANGLES=400 /
&SURF ID='HOT', TMP_FRONT=800., EMISSIVITY=1.0, TAU_T=0.01 /
&VENT XB=0,0,-1.5,1.5,1,4, SURF_ID='HOT' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&DEVC ID='minus_x', QUANTITY='RADIATIVE HEAT FLUX GAS', XYZ=4.0,0.0,2.5, ORIENTATION=-1,0,0 /
&DEVC ID='plus_x',  QUANTITY='RADIATIVE HEAT FLUX GAS', XYZ=4.0,0.0,2.5, ORIENTATION=1,0,0 /
&DEVC ID='minus_x_up', QUANTITY='RADIATIVE HEAT FLUX GAS', XYZ=4.0,0.0,2.5, ORIENTATION=0,0,1 /
&TAIL /
