&HEAD CHID='C064_kcf_radiometers', TITLE='(Concatenated) Australian Grassland Fire Experiment, Case C064' /

&MESH IJK=20,20,20, XB=-10,10,-60,-40,0,20, MPI_PROCESS=0 /
&MESH IJK=20,20,20, XB=10,30,-60,-40,0,20, MPI_PROCESS=0 /
&MESH IJK=20,20,20, XB=30,50,-60,-40,0,20, MPI_PROCESS=0 /
&MESH IJK=20,20,20, XB=50,70,-60,-40,0,20, MPI_PROCESS=0 /
&MESH IJK=20,20,20, XB=70,90,-60,-40,0,20, MPI_PROCESS=0 /
&MESH IJK=20,20,20, XB=90,110,-60,-40,0,20, MPI_PROCESS=0 /
&MESH IJK=20,20,20, XB=-10,10,-40,-20,0,20, MPI_PROCESS=1 /
&MESH IJK=20,20,20, XB=10,30,-40,-20,0,20, MPI_PROCESS=1 /
&MESH IJK=20,20,20, XB=30,50,-40,-20,0,20, MPI_PROCESS=1 /
&MESH IJK=20,20,20, XB=50,70,-40,-20,0,20, MPI_PROCESS=1 /
&MESH IJK=20,20,20, XB=70,90,-40,-20,0,20, MPI_PROCESS=1 /
&MESH IJK=20,20,20, XB=90,110,-40,-20,0,20, MPI_PROCESS=1 /
&MESH IJK=20,20,20, XB=-10,10,-20,0,0,20, MPI_PROCESS=2 /
&MESH IJK=20,20,20, XB=10,30,-20,0,0,20, MPI_PROCESS=2 /
&MESH IJK=20,20,20, XB=30,50,-20,0,0,20, MPI_PROCESS=2 /
&MESH IJK=20,20,20, XB=50,70,-20,0,0,20, MPI_PROCESS=2 /
&MESH IJK=20,20,20, XB=70,90,-20,0,0,20, MPI_PROCESS=2 /
&MESH IJK=20,20,20, XB=90,110,-20,0,0,20, MPI_PROCESS=2 /
&MESH IJK=20,20,20, XB=-10,10,0,20,0,20, MPI_PROCESS=3 /
&MESH IJK=20,20,20, XB=10,30,0,20,0,20, MPI_PROCESS=3 /
&MESH IJK=20,20,20, XB=30,50,0,20,0,20, MPI_PROCESS=3 /
&MESH IJK=20,20,20, XB=50,70,0,20,0,20, MPI_PROCESS=3 /
&MESH IJK=20,20,20, XB=70,90,0,20,0,20, MPI_PROCESS=3 /
&MESH IJK=20,20,20, XB=90,110,0,20,0,20, MPI_PROCESS=3 /
&MESH IJK=20,20,20, XB=-10,10,20,40,0,20, MPI_PROCESS=4 /
&MESH IJK=20,20,20, XB=10,30,20,40,0,20, MPI_PROCESS=4 /
&MESH IJK=20,20,20, XB=30,50,20,40,0,20, MPI_PROCESS=4 /
&MESH IJK=20,20,20, XB=50,70,20,40,0,20, MPI_PROCESS=4 /
&MESH IJK=20,20,20, XB=70,90,20,40,0,20, MPI_PROCESS=4 /
&MESH IJK=20,20,20, XB=90,110,20,40,0,20, MPI_PROCESS=4 /
&MESH IJK=20,20,20, XB=-10,10,40,60,0,20, MPI_PROCESS=5 /
&MESH IJK=20,20,20, XB=10,30,40,60,0,20, MPI_PROCESS=5 /
&MESH IJK=20,20,20, XB=30,50,40,60,0,20, MPI_PROCESS=5 /
&MESH IJK=20,20,20, XB=50,70,40,60,0,20, MPI_PROCESS=5 /
&MESH IJK=20,20,20, XB=70,90,40,60,0,20, MPI_PROCESS=5 /
&MESH IJK=20,20,20, XB=90,110,40,60,0,20, MPI_PROCESS=5 /

&TIME T_END=140.0 /

&MISC SIMULATION_MODE='SVLES', TMPA=32. /

&WIND SPEED=4.6, Z_REF=2., DIRECTION=270., L=-500., Z_0=0.03 /

&SURF ID='IGNITION', HRRPUA=1500., COLOR='RED', TMP_FRONT=100., RAMP_Q='ignitor' /
&RAMP ID='ignitor', T= 0., F=0. /
&RAMP ID='ignitor', T= 1., F=1. /
&RAMP ID='ignitor', T= 5., F=1. /
&RAMP ID='ignitor', T= 6., F=0. /

&VENT XB=0.0,1.6,-25.,25.,0.,0., SURF_ID='IGNITION', XYZ=0,0,0, SPREAD_RATE=1. /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

&SURF ID='ROAD'
      COLOR='BEIGE'
      MATL_ID='DIRT'
      THICKNESS=0.2 /

&VENT XB=-10,110,-53,-50,0,0, SURF_ID='ROAD' /
&VENT XB=-10,110, 50, 53,0,0, SURF_ID='ROAD' /
&VENT XB=-10,110, 54, 57,0,0, SURF_ID='ROAD' /
&VENT XB= -3,  0,-60, 60,0,0, SURF_ID='ROAD' /
&VENT XB=100,103,-60, 60,0,0, SURF_ID='ROAD' /
&VENT XB=104,107,-60, 60,0,0, SURF_ID='ROAD' /

&MATL ID='DIRT'
      CONDUCTIVITY = 0.25
      SPECIFIC_HEAT = 2.
      DENSITY = 1300. /

&SURF ID='GROUND'
      DEFAULT=T
      MATL_ID='DIRT'
      THICKNESS=0.2 /

&SURF ID                        = 'wet vegetation'
      MATL_ID(1,1:1)            = 'GENERIC VEGETATION'
      MOISTURE_CONTENT         = 0.063
      SURFACE_VOLUME_RATIO      = 9770.
      LENGTH                    = 0.20
      GEOMETRY                  = 'CYLINDRICAL' /

# Start of file vegetation_model.txt :
&SPEC ID='FUEL VAPOR', C=2.10, H=6.20, O=2.16/

&REAC FUEL='FUEL VAPOR', SOOT_YIELD=0.01, HEAT_OF_COMBUSTION=17425., IDEAL=T /

&SPEC ID='WATER VAPOR' /

&MATL ID                    = 'GENERIC VEGETATION'
      DENSITY               = 500.
      CONDUCTIVITY          = 0.2
      SPECIFIC_HEAT_RAMP    = 'c_v'
      A                     = 1040.
      E                     = 61041.
      NU_SPEC               = 0.75
      SPEC_ID               = 'FUEL VAPOR'
      NU_MATL               = 0.25
      MATL_ID               = 'CHAR'
      HEAT_OF_REACTION      = 418. /

&MATL ID                    = 'CHAR'
      DENSITY               = 300.
      CONDUCTIVITY          = 0.052
      SPECIFIC_HEAT_RAMP    = 'c_v'
      SURFACE_OXIDATION_MODEL = T
      A                  = 465.
      E                  = 68000.
      SPEC_ID               = 'PRODUCTS','AIR'
      NU_SPEC               = 8.13,-7.17
      MATL_ID               = 'ASH'
      NU_MATL               = 0.04
      HEAT_OF_REACTION      = -25000. /

&MATL ID                    = 'ASH'
      DENSITY               = 67.
      CONDUCTIVITY          = 0.1
      SPECIFIC_HEAT_RAMP    = 'c_v' /

&RAMP ID='c_v', T=  0., F=1.1 /
&RAMP ID='c_v', T=200., F=2.0 /
&RAMP ID='c_v', T=800., F=2.0 /


&PART ID='blade of grass'
      SAMPLING_FACTOR=5
      SURF_ID='wet vegetation'
      PROP_ID='grass image'
      DRAG_COEFFICIENT=2.8
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS'
      STATIC=T
      COLOR='BROWN' /

&INIT PART_ID='blade of grass', XB=0.,100.,-50.,50.,0.00,0.21, N_PARTICLES_PER_CELL=1, CELL_CENTERED=T, MASS_PER_VOLUME=1.33, DRY=T /

&PROP ID='grass image', SMOKEVIEW_ID='TUBE', SMOKEVIEW_PARAMETERS='L=0.20','D=0.0004','DIRZ=1' /

&DUMP DT_HRR=0.5, DT_DEVC=0.5, DT_SLCF=1.0, SIG_FIGS=5, SIG_FIGS_EXP=2 /



&DEVC ID='x', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAXLOC X', XB=-10,110,-1,0,0,1 /
&DEVC ID='D', QUANTITY='FIRE DEPTH', XB=-10,110,0,0,0.1,0.1 /



&SLCF XB=30,110,-60,60,0,20, QUANTITY='HRRPUV', CELL_CENTERED=T /
&DEVC ID='RAD_X102', QUANTITY='RADIATIVE HEAT FLUX GAS', XYZ=102.0,0.0,1.5, ORIENTATION=-1,0,0 / requested
&DEVC ID='RAD_X105', QUANTITY='RADIATIVE HEAT FLUX GAS', XYZ=105.0,0.0,1.5, ORIENTATION=-1,0,0 / requested
&DEVC ID='RAD_X108', QUANTITY='RADIATIVE HEAT FLUX GAS', XYZ=108.0,0.0,1.5, ORIENTATION=-1,0,0 / requested
&DEVC ID='RAD_X080', QUANTITY='RADIATIVE HEAT FLUX GAS', XYZ=80.0,0.0,1.5, ORIENTATION=-1,0,0 / supplementary
&DEVC ID='RAD_X090', QUANTITY='RADIATIVE HEAT FLUX GAS', XYZ=90.0,0.0,1.5, ORIENTATION=-1,0,0 / supplementary

&TAIL /
