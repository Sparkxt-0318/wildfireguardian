# --- WildfireGuardian data exclusions ---
# Raw and cached geospatial data are NEVER committed; they are
# downloaded from public sources (NASA FIRMS, Copernicus, KMA) at
# pipeline run time. Processed outputs live under data/processed/
# and are tracked selectively.
data/raw/**
!data/raw/.gitkeep
# --- SESSION 20: the 산불통계데이터 source file ------------------------
# 196 KB of public-domain CSV (공공데이터포털, 이용허락범위 제한 없음).
# Committed rather than manifest-only because seven registry entries are
# derived from it and it is small; data/raw is otherwise 1.3 GB and stays
# ignored. Blocked Sessions 16 and 17; John downloaded it manually.
!data/raw/kfs_fire_statistics/
!data/raw/kfs_fire_statistics/*.csv

data/cache/**
!data/cache/.gitkeep
# OSMnx's default HTTP response cache (./cache) — transient, never committed.
/cache/
data/processed/**
!data/processed/.gitkeep
# The small validation-results summary IS committed (5 KB of metrics, a
# key deliverable; regenerable via scripts/run_yeongdeok_validation.py).
!data/processed/yeongdeok_2025_validation_results.json
# Session-6 ablation table (41 KB; regenerable via scripts/run_ablation.py).
!data/processed/yeongdeok_2025_ablation.json
# v2 spread-model (spread_v2_xgb) result summaries (audit + CV metrics +
# importances; small JSON, key deliverables, regenerable via scripts/spread_v2/*.py).
!data/processed/spread_v2/
!data/processed/spread_v2/*.json
# ...and the notice that says NOT to cite any of them. Build A is superseded;
# the file is kept as labelled evidence, never as a source (Round-3 PHASE 1-F).
!data/processed/spread_v2/LEGACY_DO_NOT_CITE.md
# Routing-spine summaries (small JSON metrics; regenerable via
# scripts/run_routing_integration.py). The bulk .npz figure data stays ignored.
!data/processed/spread_v2_lofo.json
!data/processed/yeongdeok_forward_sim.json
!data/processed/routing_demo.json
# Round-3 network-drift experiment: what moves when ONLY the OSM road network
# moves (docs/network_drift.md). Small JSON, and it is the ONLY surviving
# record of the comparison — arm A's road network no longer exists.
!data/processed/network_drift_experiment.json
# Round-3 PHASE 2: slope-aware 459-origin re-runs at three sampling spacings
# (docs/slope_integration.md). Small JSON; the committed
# real_roads_real_hazard.json is untouched.
!data/processed/real_roads_real_hazard_slope_*.json
# PHASE 2-C-1: routing-objective 2x2 (distance-min vs time-min x flat vs slope).
!data/processed/routing_objective_experiment.json
# PHASE 2-C-2: w(t) budget sweep, closing the Round-2 V-2 future-work item.
!data/processed/budget_sweep_experiment.json
# PHASE 3-B: full-coverage re-run with every origin serialized (441 rows).
# Drift values (441/174/32), NOT the committed values — see docs/network_drift.md.
!data/processed/rescue_routing_full.json
# Origin sparsity sweep + nearest-neighbour distributions (small JSON).
!data/processed/cluster_sparsity.json
# ---------------------------------------------------------------------------
# PHASE 5 — multi-region extension (docs/multi_region.md).
#
# STEP 2-1/2-2 produced forward_sim_regions.json, hazard_{region}.npz,
# osm_acquisition.json and osm_completeness.json but never allow-listed them,
# so they existed only in one working tree. STEP 2-3/4 depends on all four:
# without them `make verify` fails on a fresh clone with "source_file missing"
# for every mr_* entry. Adding the exceptions here is what makes the
# multi-region numbers checkable by someone who did not run them.
#
# The two hazard .npz files are 17-28 KB — the per-region equivalent of the
# already-tracked routing_demo.npz, not bulk figure data.
!data/processed/forward_sim_regions.json
!data/processed/hazard_uiseong_andong_2025.npz
!data/processed/hazard_uljin_samcheok_2022.npz
!data/processed/osm_acquisition.json
!data/processed/osm_completeness.json
# STEP 2-3 routing outputs, one per region. The committed Yeongdeok
# real_roads_real_hazard.json is a DIFFERENT file and is untouched.
!data/processed/real_roads_real_hazard_uiseong_andong_2025.json
!data/processed/real_roads_real_hazard_uljin_samcheok_2022.json
# STEP 4 cross-region table.
!data/processed/multi_region_comparison.json
# PHASE 14 — the weather-dependency ceiling. Registered in NUMBERS.json, so it
# must be tracked or `make verify` fails on a fresh clone with 'source_file missing'.
!data/processed/weather_dependency.json
# DEM re-acquisition provenance (2026-08-02): what was replaced, by what, and
# the digest of both. Small JSON; the rasters live in the snapshot store below.
!data/processed/dem_acquisition.json
# Measurements of what the DEM defect cost (2026-08-02). ADDITIVE EVIDENCE:
# none of these supersedes a committed artifact, and spread_v2_lofo.json,
# routing_demo.npz and yeongdeok_forward_sim.json are untouched.
!data/processed/spread_v2_lofo_dem_corrected.json
!data/processed/dem_negative_elevation_audit.json
!data/processed/yeongdeok_dem_sensitivity.json
# Why routing_demo.npz and yeongdeok_forward_sim.json disagree (archaeology,
# boundary forensics, parameter sweep). Declares no winner.
!data/processed/routing_demo_divergence.json
# The CANONICAL Yeongdeok hazard field and the 459-series scan on it. NEW files:
# routing_demo.npz is untouched and still carries the digest the submission
# cites. Which field is published is not decided here.
!data/processed/routing_demo_canonical.npz
!data/processed/canonical_hazard.json
!data/processed/real_roads_real_hazard_canonical.json
# Step 2: the 30/60/90 m slope sweep on the canonical field. The committed
# real_roads_real_hazard_slope_*.json describe the same sweep on the reverted
# run's field and are untouched.
!data/processed/slope_sweep_canonical.json
# Step 3: routing objective (2-C-1) + w(t) budget sweep (2-C-2) on the canonical
# field. routing_objective_experiment.json and budget_sweep_experiment.json,
# which measure the same experiments on the reverted field, are untouched.
!data/processed/objective_budget_canonical.json
# Step 4: what re-drawing Yeongdeok's walk bbox would cost. ESTIMATE ONLY — the
# script performs no network I/O and nothing was acquired.
!data/processed/yeongdeok_bbox_reacquisition_estimate.json
# PHASE 18 — real building locations. The acquisition provenance and the
# snapping measurement. Allow-listed for the same reason the PHASE-5 artifacts
# were: without an exception they live in one working tree only, and a report
# that cites them cannot be checked on a fresh clone.
!data/processed/osm_buildings_acquisition.json
!data/processed/building_snapping_measurement.json
!data/processed/building_origin_routing.json
!data/processed/building_spatial_bias.json
# AUC-interval + ML-baseline analysis outputs (per-fire DeLong CIs / significance;
# logistic/RF vs GBM comparison; persisted LOFO out-of-fold predictions). These are
# the result artifacts of scripts/auc_intervals.py and scripts/ml_baselines.py;
# they require the (git-ignored) FIRMS/ERA5/DEM bundle to regenerate, so they are
# absent in a fresh clone. The exceptions ensure that once produced locally they are
# git-trackable rather than silently swallowed by the data/processed/** rule.
!data/processed/auc_intervals.json
!data/processed/ml_baselines.json
!data/processed/spread_v2_lofo_oof.parquet
!data/processed/spread_v2_lofo_oof.csv.gz
# Round-2 P2 calibration measurement: pooled/per-fold Brier + ECE (15 equal-count
# bins) + reliability data for the canonical GBM vs random-forest/logistic on the
# same LOFO OOF, plus the per-model baseline OOF frames. Result artifacts of
# scripts/calibration_metrics.py; require the FIRMS/ERA5/DEM bundle to regenerate,
# so absent in a fresh clone but git-trackable once produced.
!data/processed/calibration_metrics.json
!data/processed/lofo_oof_random_forest.csv.gz
!data/processed/lofo_oof_logistic.csv.gz
# Rescue-aware routing summary (small JSON; regenerable via
# scripts/run_rescue_routing.py). The bulk rescue_routing.npz stays ignored.
!data/processed/rescue_routing.json
# Rescue verification/reconciliation (single-baseline + full-N 2-D sweeps;
# regenerable via scripts/verify_rescue_routing.py [--sweep vehicle|fc|capacity]).
!data/processed/rescue_verify.json
!data/processed/rescue_verify_fc.json
# Rescue capacity / triage demand–supply sweep (small JSON; PoC capacity params;
# regenerable via scripts/verify_rescue_routing.py --sweep capacity).
!data/processed/rescue_capacity.json
# PHASE 23 dispatch-ordering comparison: contribution ② against three alternative
# orderings over 270 configurations, three arms, plus the measured proof that the
# SHIPPED capacity model is ordering-blind on the Yeongdeok list. Regenerable via
# scripts/run_dispatch_ordering.py from the snapshot store and the committed
# hazard npz files (no network I/O, seeds pinned), but it must be in-tree because
# five NUMBERS.json entries read from it and would otherwise be uncheckable on a
# fresh clone.
!data/processed/dispatch_ordering_comparison.json
# PHASE 24 ordering-boundary map: the same comparison with the W axis filled in
# from 2 points to 12 (60…600), 2,160 headline cells, plus the deadline-key
# spread statistics and the in-run re-derivation of every PHASE 23 value at
# W = 75 and W = 240 (3,744 values, 0 differences). ⚠ 4.5 MB — larger than any
# other allowlisted artifact here, and deliberately so: the per-cell grid is
# what six NUMBERS.json entries index into, and the deduplicated view
# (deadline_statistics_by_arm_and_window) is derived FROM it rather than
# replacing it. Regenerable via scripts/run_ordering_boundary.py from the
# snapshot store and the committed hazard npz files (no network I/O, seeds
# pinned, ~176 s), but it must be in-tree or those entries are uncheckable on a
# fresh clone.
!data/processed/ordering_boundary.json
# Pre-flip SYNTHETIC baseline snapshot of the four rescue JSONs, kept in-tree so
# the Round-2 report's OLD(synthetic) column is verifiable alongside the NEW(real)
# outputs in one commit. Regenerable with the scripts' --synthetic flag.
!data/processed/rescue_baseline_synthetic/
!data/processed/rescue_baseline_synthetic/*.json
# --- SESSION 18: the last cited artifacts that were not in the repository ----
# 41 NUMBERS.json entries pointed at files that existed only on the machine the
# work was done on. That breaks the provenance rule at its root: a cited number
# whose artifact is not in the repository cannot be checked by anyone else,
# including a judge at a booth.
#
# 18 files, 108 KB, ALL text JSON, so the first preference applies — commit
# them, and narrow this ignore rather than removing it. Nothing is near the
# 50 MB stop-gate and Git LFS is not involved.
#
# The arm LOFO outputs (Sessions 10-13). Each is a per-fold metric record, not
# bulk data; regenerable via scripts/arm_d_build.py and scripts/arm_e_lofo.py.
!data/processed/arms/
!data/processed/arms/*/
!data/processed/arms/*/*.json
# The Layer 0 vulnerability layer (Sessions 14-17). Every file here is a small
# metrics JSON written by scripts/vulnerability_*.py.
!data/processed/vulnerability/
!data/processed/vulnerability/*.json
# ⚠ NOT the per-item resume caches under vulnerability/*_cache/ — those are a
# run-time convenience, they are regenerated by the same commands, and no
# document or registry entry cites one.
data/processed/vulnerability/*_cache/
data/processed/vulnerability/precompute/
data/processed/vulnerability/portability_cache/
data/processed/vulnerability/refuges/

# --- SESSION 18 Phase 4: cell-level classification metrics -------------------
# The OOF probabilities with cell identity attached (fire_id, op_from, row, col)
# so recall, precision or any per-location metric can be recomputed later
# WITHOUT re-running the model — 1.9 MB, the same class as the three .csv.gz
# OOF files already allowlisted above. And the metrics JSON six registry
# entries read from.
!data/processed/spread_v2_lofo_oof_cells.csv.gz
!data/processed/oof_classification_metrics.json
# Phase 5: evidence that the vulnerability score's margin clause is inert.
!data/processed/vulnerability/clearance_diagnostic.json

# --- SESSION 19: GK2A detection floor ----------------------------------------
# 1.1 MB of small text JSON. The per-step traces are kept, not just the summary,
# because the finding is partly a NON-detection (영덕) and a reader has to be
# able to see every step that did not fire, not take the absence on trust.
!data/processed/detection/
!data/processed/detection/*.json
!data/processed/detection/steps/
!data/processed/detection/steps/*.json

# --- WFG-019: the operating-point evidence package ---------------------------
# ~9 KB of text JSON. Committed because seventeen registry entries read it and
# because the threshold-calibration table is a NEGATIVE result — the per-fire
# rows are the evidence that the calibration fails, so a reader has to be able
# to see every held-out fire, not take the summary on trust.
!data/processed/operating_point/
!data/processed/operating_point/*.json

# WFG-020: figures transcribed from a third-party survey report. The 3.4 MB PDF
# itself stays out (data/raw/**, and it is not ours to redistribute); this JSON
# is the committed carrier, so the numbers travel with their sha256, their table
# and page references, and the note that this project did not measure them.
!data/processed/evidence/
!data/processed/evidence/*.json

# WFG-100: the booth script's second budget. ~1 KB of JSON per measurement, and it
# is the artifact two registry keys re-derive from, so it has to be in the clone a
# stranger checks out. One file per measurement, never overwritten (CHARTER §3.2):
# editing a spoken line means a new stamp, and the old count stays as the record of
# what the script used to be. docs/demo_script_pace.md.
!data/processed/demo_script_pace/
!data/processed/demo_script_pace/*.json

# Validation-case manifest JSON files ARE committed (they're stubs, not
# bulk data).
!data/validation_cases/**

# Geospatial / scientific binary formats are excluded by extension
# anywhere in the tree so an accidental drop into src/ or notebooks/
# still gets caught.
*.tif
*.tiff
*.nc
*.nc4
*.hdf

# ...with ONE exception: the SNAPSHOT copies of the per-region DEMs (~16 MB for
# all three). Everything else under data/snapshots/ is committed, and these are
# the reason why. `routing/slope.py` samples the DEM directly and `spread_v2`
# reprojects it onto the simulation grid; a defect in it changes results
# WITHOUT RAISING — which is exactly what the 2026-08-02 Uljin-Samcheok raster
# did for months (docs/dem_defect_2026-08-02.md). Recording only a digest would
# let a future reader detect that the input had changed but never recover the
# one the numbers were computed on. The working copies in data/raw/ stay
# ignored; these are the evidence layer.
!data/snapshots/srtm-dem_*.tif
*.hdf5
*.h5
*.zip
*.tar
*.tar.gz
*.grib
*.grib2
*.bil
*.bin

# Large rasters / shapefiles
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Generated animation/video outputs that are too large for git
*.mp4
*.mov
*.avi

# Allow small reference figures
!docs/figures/*.png
!docs/figures/*.svg

# --- Snapshot store (data/snapshots/) -------------------------------------
# The store IS committed — it is the evidence layer that Round 2 lacked
# (see data/snapshots/README.md). Two exceptions are kept local-only:
#
#   osm-httpcache_*  raw Overpass API responses, ~24 MB. Fully derivable from
#                    the committed .graphml.gz, so they add bulk without adding
#                    reproducibility. Their sha256 digests ARE recorded in
#                    MANIFEST.json, so a future fetch can still be compared
#                    byte-for-byte against what Round 2 actually received.
data/snapshots/osm-httpcache_*
# ...but the tiny .sha256 sidecars stay in git: every snapshot's digest is
# checkable from a fresh clone even when the payload itself is local-only.
!data/snapshots/osm-httpcache_*.sha256

# --- outputs/dispatch/ (Round-3 PHASE 3) ----------------------------------
# Every sheet is committed as HTML (the canonical artifact, openable and
# screenshot-able in any browser) together with its broadcast script, SMS
# drafts and MANIFEST.json — 0.23 MB for all 33 clusters.
#
# The PDFs are NOT all committed: headless Chrome embeds a Korean font subset
# in each one, so 33 sheets come to 6.7 MB of fully regenerable output. The
# three largest clusters' PDFs ARE kept as evidence that the A4 conversion
# works and fits on a single page. Regenerate the rest with:
#     python scripts/generate_dispatch_outputs.py
outputs/dispatch/*/*/dispatch_a4.pdf
!outputs/dispatch/*/01-*/dispatch_a4.pdf
!outputs/dispatch/*/02-*/dispatch_a4.pdf
!outputs/dispatch/*/03-*/dispatch_a4.pdf

# Same policy for the full-coverage re-run (PHASE 3-B, 107/82/63 clusters
# across three eps values). HTML/text/JSON for every cluster is committed;
# only the three largest clusters' PDFs per set are kept as evidence.
outputs/dispatch_full/*/*/dispatch_a4.pdf
!outputs/dispatch_full/*/01-*/dispatch_a4.pdf
!outputs/dispatch_full/*/02-*/dispatch_a4.pdf
!outputs/dispatch_full/*/03-*/dispatch_a4.pdf
# ...and the split sheets, which are the evidence that the overflow guard
# works (and where it cannot help).
!outputs/dispatch_full/*/0[123]-*/dispatch_a4_dispatch.pdf
!outputs/dispatch_full/*/0[123]-*/dispatch_a4_unreachable.pdf

# --- outputs/live/ (Round-3 PHASE 6) --------------------------------------
# The replay run is committed as evidence that the demonstration path works
# end to end offline: RUN.json, MANIFEST.json and every village's HTML sheet,
# broadcast script and SMS drafts. Same PDF policy as above — headless Chrome
# embeds a Korean font subset per file, so only the three largest clusters'
# PDFs per run are kept. Regenerate the rest with:
#     python scripts/run_live_detection.py --replay
# Depth-independent: since PHASE 8 added a second region, runs nest one level
# deeper (outputs/live/{mode}/{region}/{stamp}/…) and the old fixed-depth glob
# silently stopped matching — 188 PDFs were staged before this was caught.
outputs/live/**/dispatch_a4.pdf
!outputs/live/**/01-*/dispatch_a4.pdf
!outputs/live/**/02-*/dispatch_a4.pdf
!outputs/live/**/03-*/dispatch_a4.pdf
#
# The LIVE branch's raw FIRMS payloads are NOT committed here: they are
# acquisitions, and acquisitions belong in the snapshot store, which
# scripts/run_live_detection.py writes to on every poll. Committing them twice
# would create a second copy that could drift from the digest that pins it.
outputs/live/**/firms_raw/
# The seen-set is per-machine runtime state, not evidence.
outputs/live/**/state_*.json

# scratch dataset cache for scripts/measure_weather_dependency.py
.cache_weather_dependency.pkl

# --- autonomous loop scratch (scripts/auto/) ---
.auto/

# --- external published figures (WFG-049): the README opening numbers with agency, date, scope, URL
!data/processed/external/
!data/processed/external/*.json

# --- 영덕 subset of the author's 주소정보누리집 downloads (2026-09-04): small GeoJSON + manifest
!data/processed/external/juso_yeongdeok/
!data/processed/external/juso_yeongdeok/*.geojson
!data/processed/external/juso_yeongdeok/manifest.json

# --- private contact material never belongs in this public repository (NH-023, 2026-09-04)
outreach/
*_recipients.csv

# --- Finals release bundle (WFG-036) ---
# The payload is copied out of the tree by `make finals-bundle`, so committing it
# would be a second copy of web/ going stale beside the first (CHARTER 3.2). One
# copy plus a hash instead of two copies: what IS committed is README_KO.md and
# MANIFEST.json, the SHA-256 of every file the bundle should contain, and a stale
# hash fails a test where a stale 2.1 MB copy fails nothing. See
# docs/finals_bundle.md.
release/kcf-finals-2026/web/
release/kcf-finals-2026/CITATION.cff
release/kcf-finals-2026/LICENSE
# Same rule, added by WFG-037: the copy checker travels IN the bundle so the
# laptop-has-died case can run it, and its source of truth is scripts/.
release/kcf-finals-2026/check_bundle_copy.py
