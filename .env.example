# Copy this file to `.env` and fill in real credentials.
# `.env` is gitignored — never commit real keys.

# --- NASA FIRMS (Fire Information for Resource Management System) ---
# Issue a MAP_KEY here: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_MAP_KEY=

# --- Copernicus Climate Data Store (ERA5 reanalysis, fuel moisture proxies) ---
# Register at https://cds.climate.copernicus.eu/ and get a UID:KEY pair.
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=

# --- KMA (Korea Meteorological Administration) Public API ---
# Register at https://data.kma.go.kr/ for a service key (AWS station data,
# numerical weather prediction outputs, etc.).
KMA_API_KEY=

# --- Optional: Mapbox or other basemap tokens for the web demo ---
MAPBOX_TOKEN=

# --- Cache directory (defaults to data/cache/) ---
WILDFIREGUARDIAN_CACHE_DIR=data/cache
